{
  "name": "mulearnhome",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.2.17",
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not < 0.5%"
  ],
  "scripts": {
    "preinstall": "node -e \"if(process.env.npm_execpath.indexOf('bun')===-1){console.error('\\x1b[31m❌ This project requires bun. Please use bun install instead.\\x1b[0m');process.exit(1)}\"",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "bun run typecheck && bun run lint",
    "optimize:images": "bun run scripts/optimize-images.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@next/third-parties": "^16.3.4",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.2.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.544.0",
    "next": "16.1.2",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.87.0",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
